# QB — Production environment template
# Copy to deploy/.env and fill in real values (setup.sh generates this for you).
#
# IMPORTANT: never commit the real .env — it contains secrets.

# --- Domain (public address of your app) ---
# For free HTTPS use a DuckDNS subdomain, e.g. qb-app.duckdns.org
# Leave EMPTY to run on the raw server IP over plain HTTP (no TLS).
DOMAIN=

# --- Secrets (setup.sh auto-generates strong values) ---
# Long random string for JWT signing.
SECRET_KEY=
# PostgreSQL password for the app user.
POSTGRES_PASSWORD=

# --- First admin (created on first boot when the users table is empty) ---
FIRST_ADMIN_EMAIL=admin@qb.com
FIRST_ADMIN_FULL_NAME=مدير النظام
FIRST_ADMIN_PASSWORD=

# --- URLs (derived from DOMAIN by setup.sh; edit only if you use IP) ---
SITE_ADDRESS=:80
ALLOWED_ORIGINS=http://localhost:8080
TRUSTED_HOSTS=*
FRONTEND_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8000

# --- Email (optional) ---
# Leave SMTP_HOST empty to log emails to console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QB System <no-reply@qb-system.com>
SMTP_USE_TLS=true