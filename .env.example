# ===== Backend =====
# Database: use postgresql+asyncpg for production, sqlite+aiosqlite for local dev
DATABASE_URL=postgresql+asyncpg://qb_user:qb_password@localhost:5432/qb_db
# Local dev fallback:
# DATABASE_URL=sqlite+aiosqlite:///./qb_dev.db

# JWT
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS — comma-separated list of allowed origins (no spaces)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Seed — set false in production (default demo users/entities are NOT created)
SEED_DEFAULT_USERS=true

# Login security — rate limit (per IP) + account lockout (per user)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Trusted hosts (comma-separated). "*" = any (dev only). In production list your domain.
TRUSTED_HOSTS=*

# Email (SMTP) — empty SMTP_HOST = emails are logged to console (dev mode)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxx
# SMTP_FROM=QB System <no-reply@your-domain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QB System <no-reply@qb-system.com>

# Public URL used inside email links (verify/reset)
FRONTEND_URL=http://localhost:5173
EMAIL_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# App
API_V1_STR=/api/v1
PROJECT_NAME=نظام إدارة المقاولات المتكامل
