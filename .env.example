# ===== Backend =====
# Database: use postgresql+asyncpg for production, sqlite+aiosqlite for local dev
DATABASE_URL=postgresql+asyncpg://qb_user:qb_password@localhost:5432/qb_db
# Local dev fallback:
# DATABASE_URL=sqlite+aiosqlite:///./qb_dev.db

# JWT
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS — comma-separated list of allowed origins (no spaces)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# App
API_V1_STR=/api/v1
PROJECT_NAME=نظام إدارة المقاولات المتكامل
