# Frontend (Vite) env vars — copy to .env and adjust
# Backend API base URL. In docker-compose the frontend nginx container talks
# to the host browser, so use the public backend URL.
# Local dev default: http://127.0.0.1:8000/api/v1
VITE_API_URL=http://127.0.0.1:8000/api/v1

# API timeout in milliseconds (default: 15000)
VITE_API_TIMEOUT=15000
